# Copy this folder OUTSIDE the git repo, then: cp .env.example .env  and edit the values.
# Passwords: at least 6 characters, letters and digits only (special characters break the setup curl).
STACK_VERSION=9.5.3
ELASTIC_PASSWORD=changemeElastic1
KIBANA_PASSWORD=changemeKibana1
# 32+ random characters. Generate one with:  python -c "import secrets; print(secrets.token_hex(16))"
KIBANA_ENCRYPTION_KEY=replace_with_32_plus_random_chars_000
# Elasticsearch JVM heap. 1g is enough for local testing and keeps RAM free for a local LLM.
ES_HEAP=1g
